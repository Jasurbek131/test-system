# ---------- Baza ----------
DB_NAME=test_system
DB_USERNAME=test_system
DB_PASSWORD=change_me_db_password

# ---------- JWT (kamida 32 belgi) ----------
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRATION_HOURS=24

# ---------- Default admin (birinchi ishga tushishda yaratiladi) ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password
ADMIN_FULL_NAME=Administrator

# ---------- Boshqa ----------
# backend/src/main/resources/seed/*.json dagi fanlarni (bazada yo'q bo'lsa) avtomatik yuklash
SEED_DATA=true
# Frontend qaysi portda ochiladi (http://localhost:3000)
FRONTEND_PORT=3000
